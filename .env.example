TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Override if you want a different model. Defaults to gemini-2.5-flash.
# Other options: gemini-2.5-pro (slower, deeper analysis), gemini-2.0-flash (older).
GEMINI_MODEL=gemini-2.5-flash
FREE_ANALYSES_PER_DAY=2
MAX_VIDEO_SIZE_MB=200
# Telegram's standard Bot API caps `getFile` downloads at 20 MB.
# Bump to 2000 only if you run a self-hosted Local Bot API server.
TELEGRAM_FILE_LIMIT_MB=20
# Optional: point at a self-hosted Local Bot API server.
# Leave blank to use Telegram's cloud (https://api.telegram.org).
# When set, the bot uses local-mode and reads files directly off disk.
# Example for a Docker container on the same host:
#   TELEGRAM_API_BASE_URL=http://localhost:8081/bot
#   TELEGRAM_API_FILE_URL=http://localhost:8081/file/bot
#   TELEGRAM_API_LOCAL_DATA_DIR=~/telegram-bot-api/data   # the HOST side
#     of `-v ~/telegram-bot-api/data:/var/lib/telegram-bot-api` in docker run.
TELEGRAM_API_BASE_URL=
TELEGRAM_API_FILE_URL=
TELEGRAM_API_LOCAL_DATA_DIR=
ADMIN_TELEGRAM_ID=
LOG_LEVEL=INFO
DB_PATH=data/bot.db
LOG_FILE=logs/bot.log
